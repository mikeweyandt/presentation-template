{
  "name": "Marp — University of Akron",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "marp-team.marp-vscode"
      ],
      "settings": {
        "markdown.marp.themes": [
        "./themes/akron.css",
        "./themes/akron-cs.css",
        "./themes/akron-cs-handout.css"
      ],
        "markdown.marp.enableHtml": true,
        "markdown.marp.browser": "chrome",
        "markdown.marp.browserPath": "/usr/local/bin/marp-browser"
      }
    }
  },
  "postCreateCommand": "uname -m && marp --version && marp-browser --version"
}
