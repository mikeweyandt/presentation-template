{
  "name": "Marp — University of Akron",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "marp-team.marp-vscode"
      ],
      "settings": {
        "markdown.marp.themes": ["./themes/akron.css"],
        "markdown.marp.enableHtml": true
      }
    }
  },
  "postCreateCommand": "marp --version && chromium --version"
}
